<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View openlibrary.book_repository View List -->
    <record id="view_openlibrary_book_repository_list" model="ir.ui.view">
        <field name="name">view.openlibrary.book_repository.list</field>
        <field name="model">openlibrary.book_repository</field>
        <field name="arch" type="xml">
            <list 
                decoration-info="repository_type == '3'"
                decoration-warning="repository_type == '2'"
                decoration-danger="repository_type == '4'"
                decoration-muted="repository_type == '8'"           
                string ="Books in Repository"
            >
                <header>

                </header>
                <field name="status" widget="badge" class="text-center"
                        decoration-info="status == 'free'"
                        decoration-success="status == 'lent'"
                        decoration-warning="status == 'delay'"
                        decoration-danger="status == 'suspicious'"
                        decoration-primary="status == 'dangerous'"
                /> 
                <field name="code" />
                <field name="name"/>
                <field name="library_id" />
                <field name="repository_id" />
                <button name="button_lending_this_book" string="Lend" type="object" class="btn-success btn-block btn-lg" invisible="is_lent == True" context="{'return_source': 'form'}"/>                       
                <button name="button_return_book" string="Return" type="object" class="btn-info btn-block btn-lg" invisible="is_lent == False" context="{'return_source': 'list'}"/>
                <field name="active" class="text-center"/>
                <field name="repository_type" class="text-center"/>
                <field name="currency_id" invisible="1" />
                <field name="purchase_price" widget="manetary" options="{'currency_field': 'currency_id'}"/>
                <field name="book_edition_id" />
            </list>
        </field>
    </record>

    <!-- View openlibrary.book_repository form -->
    <record id="view_openlibrary_book_repository_form" model="ir.ui.view">
        <field name="name">view.openlibrary.book_repository.form</field>
        <field name="model">openlibrary.book_repository</field>
        <field name="arch" type="xml">
            <form string="Books in Repositories">
                <header>
                    <button name="button_lending_this_book" string="Lend" type="object" class="btn-primary" invisible="is_lent == True" context="{'return_source': 'form'}"/>                       
                    <button name="button_return_book" string="Return" type="object" class="btn-warning" invisible="is_lent == False"  context="{'return_source': 'form'}"/>
                    <button name="repeat_this_book" string="Repeat Book" type="object" class="oe_highlight" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <!-- وضعیت کتاب -->
                        <field name="is_lent" invisible="1"/>
                        <field name="current_lend_id" invisible="1"/>
                    </div>
                    
                    <group>
                        <field name="book_edition_id" />
                        <field name="status" readonly="True"/>             
                        <field name="library_id" />
                        <field name="repository_id" />
                        <field name="repository_type" />
                        <field name="code" />
                        <field name="currency_id" invisible="1" />
                        <field name="purchase_price" widget="manetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="active" />
                        <field name="is_lent" 
                               widget="boolean_toggle"
                               readonly="1"/>
                    </group>
                    <notebook>
                        <page name="lending_history_book" string="Lending History">
                            <field name="lend_ids" readonly="1">
                                <list edit="0" default_order="start_date DESC">
                                    <field name="subscriber_id"/>
                                    <field name="start_date" />
                                    <field name="return_date" />
                                    <field name="days_late" />
                                    <field name="subscriber_due_day" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View openlibrary.book_repository search -->
    <record id="view_openlibrary_book_repository_search" model="ir.ui.view">
        <field name="name">view.openlibrary.book_repository.search</field>
        <field name="model">openlibrary.book_repository</field>
        
        <field name="arch" type="xml">
            <search>
                <!-- فیلدهای جستجوی ساده -->
                <field name="name"/>
                <field name="code"/>
                <field name="repository_id"/>
                <field name="library_id"/>
                <filter name="available_books" 
                        string="Available Books" 
                        domain="[('status', '=', 'free')]"/>

                <filter name="lent_books" 
                    string="Lent Books" 
                    domain="[('status', '!=', 'free')]"/>

                <filter name="delayed_books" 
                    string="Delayed Books" 
                    domain="[('status', 'in', ['delay', 'suspicious', 'dangerous'])]"/>

                <separator/>
                
                <!-- فیلترهای وضعیت فعال -->
                <filter name="active_books" 
                        string="Active Books" 
                        domain="[('active', '=', True)]"/>
                
                <filter name="inactive_books" 
                        string="Inactive Books" 
                        domain="[('active', '=', False)]"/>
                
                <!--separator/-->
                <!-- گروه‌بندی -->
                <group>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_status" string="Library" context="{'group_by': 'library_id'}"/>
                    <filter name="group_by_status" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="group_by_status" string="Book" context="{'group_by': 'book_id'}"/>
                </group>
  

            </search>
        </field>
    </record>

    <!-- Action openlibrary.book_repository -->
    <record id="action_openlibrary_book_repository" model="ir.actions.act_window">
        <field name="name">Books in Repositories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openlibrary.book_repository</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Openlibrary Book_repository.
            </p>
        </field>
        <field name="usage">menu</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="path">book-repositories</field>
        <!-- <field name="binding_view_types">form</field>         -->
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View openlibrary.repository View List -->
    <record id="view_openlibrary_repository_list" model="ir.ui.view">
        <field name="name">view.openlibrary.repository.list</field>
        <field name="model">openlibrary.repository</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="library_id" />
                <field name="active" />
                <field name="type" />
            </list>
        </field>
    </record>

    <!-- View openlibrary.repository form -->
    <record id="view_openlibrary_repository_form" model="ir.ui.view">
        <field name="name">view.openlibrary.repository.form</field>
        <field name="model">openlibrary.repository</field>
        <field name="arch" type="xml">
            <form string="Repositories">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <field name="name" placeholder="Name..."/>
                        <field name="library_id" readonly="True"/>
                        <field name="active" />
                        <field name="type" />
                    </group>
                    <notebook>
                        <page name="books" string="Books">
                            <field name="book_repo_ids">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="purchase_price" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View openlibrary.repository search -->
    <record id="view_openlibrary_repository_search" model="ir.ui.view">
        <field name="name">view.openlibrary.repository.search</field>
        <field name="model">openlibrary.repository</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record>


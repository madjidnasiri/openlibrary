<odoo>
    <record model="ir.ui.view" id="openlibrary.publisher_form">
      <field name="name">openlibrary form</field>
      <field name="model">openlibrary.publisher</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group name="" string="">
              <field name= "name"/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="openlibrary.action_publishers">
      <field name="name">Publishers</field>
      <field name="res_model">openlibrary.publisher</field>
      <field name="view_mode">list,form</field>
      <field name="path">publishers</field>
    </record>

</odoo>

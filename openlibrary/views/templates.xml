<odoo>
    <data>
        <template id="ws_author_list">
          <t t-call="website.layout">
            <t t-set="title" t-value="Authors"/>
              <hr/>
              <div class="oe_structure">
                <div class="container">
                  <t t-if="authors">
                    <t t-foreach="authors" t-as="author">
                      <p>
                        <t t-esc="author.id"/> |
                        <snap>
                        <a t-attf-href="/ol/author/{{ slug(author) }}">
                         <t t-esc="author.name"/> <t t-esc="author.family"/>
                        </a>
                        </snap>
                      </p>
                    </t>
                  </t>
                  <t t-else="">
                    <p>No Record Found</p>
                  </t>
                </div>
              </div>
              <hr/>
          </t>
        </template>

        <template id="ws_author_view">
          <t t-call="website.layout">
            <title>Authors</title>
            <t t-set="title" t-value="Author" />
            <hr/>
              <div class="oe_structure">
                <div class="container">
                  <h3><span t-field="author.name"/> <span t-field="author.family"/></h3>
                  <hr/>
                  <h4>ID: <span t-field="author.id"/></h4><p>Last Modify: <i t-field="author.write_date" t-options="{'format': 'long'}"/></p>
                  <span t-field="author.biography"/>
                </div>
              </div>
            <hr/>
          </t>
        </template>

        <template id="book_repositories_public_user">
          <t t-call="website.layout">
            <t t-set="Title" t-value="'Books status'"/>
            <div class="oe_structure">
              <div class="container">
                <h1>Books in repository</h1>
                <hr/>
                <t t-if="books">
                  <table class="table table-striped">
                    <thead>
                      <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Library/Repository</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-set="row_no" t-value="0"/>
                      <t t-foreach="books" t-as="book">
                        <t t-set="row_no" t-value="row_no + 1"/>
                        <tr t-attf-class="{'table-secondary': row_no % 2 == 0}">
                          <td><t t-esc="book.id"/></td>
                          <td><t t-esc="book.name"/></td>
                          <td><t t-esc="book.repository_id.display_name"/></td>
                          <td><t t-esc="book.status"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </t>
                <t t-else="">
                  <p>No Record Found</p>
                </t>
              </div>
            </div>
          </t>
        </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View openlibrary.tag View List -->
    <record id="view_openlibrary_tag_list" model="ir.ui.view">
        <field name="name">view.openlibrary.tag.list</field>
        <field name="model">openlibrary.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View openlibrary.tag form -->
    <record id="view_openlibrary_tag_form" model="ir.ui.view">
        <field name="name">view.openlibrary.tag.form</field>
        <field name="model">openlibrary.tag</field>
        <field name="arch" type="xml">
            <form string="Tags">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View openlibrary.tag search -->
    <record id="view_openlibrary_tag_search" model="ir.ui.view">
        <field name="name">view.openlibrary.tag.search</field>
        <field name="model">openlibrary.tag</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record>

    <!-- Action openlibrary.tag -->
    <record id="action_openlibrary_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openlibrary.tag</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="path">tags</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Openlibrary Tag.
            </p>
        </field>
    </record>

</odoo>

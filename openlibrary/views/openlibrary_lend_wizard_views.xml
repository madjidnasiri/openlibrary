<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="book_lending_wizard_form" model="ir.ui.view">
            <field name="name">openlibrary.lend_wizard.form</field>
            <field name="model">openlibrary.lend_wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="library_id" readonly="True"/>
                            <field name="book_repo_id" readonly="True"/>
                            <field name="subscriber_id" />
                            <field name="lend_date"/>
                        </group>
                        <footer>
                            <button string="Lend" class="oe_highlight" data-hotkey="c" name="lending_book" type="object"/>
                            <button string="Cancel" special="cancel" class="btn btn-secondary" data-hotkey="x" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- View openlibrary.return_book_wizard form -->
        <record id="view_openlibrary_return_book_wizard_form" model="ir.ui.view">
            <field name="name">view.openlibrary.return_book_wizard.form</field>
            <field name="model">openlibrary.return_book_wizard</field>
            <field name="arch" type="xml">
                <form string="Openlibrary | Return Book"
                                decoration-danger="book_status == 'dangerous'" 
                                decoration-warning="book_status == 'suspicious'" 
                                decoration-primary="book_status == 'delay'"
                                decoration-success="book_status == 'lent'"
                                decoration-muted="book_status == 'free'"                
                >
                    <sheet>
                        <!-- <div class="alert alert-danger" role="alert" invisible="days_late == 0" > -->
                        <div class="alert alert-danger" role="alert" invisible="book_status in ['free', 'lent']">
                            <i class="oi oi-warning" title="Warning" aria-label="Warning"></i>
                            <span style="font-size: 16px;">⚠️</span>
                            <strong>Warning!</strong> 
                                This book is <strong style="font-size: 16px;"><field name="days_late"/></strong> day(s) past due date. A late fee may apply.
                        </div> 
                        <group>
                            <field name="library_id" readonly="True"/>
                            <field name="book_repo_id" readonly="True"/>
                            <field name="book_status" readonly="True"/>
                            <field name="subscriber_id" readonly="True" />
                            <field name="subscriber_due_day" readonly="True"/>
                            <field name="start_date" readonly="True"/>
                            <field name="due_date" readonly="True"/>
                            <field name="days_late" readonly="True" 
                                decoration-danger="book_status == 'dangerous'" 
                                decoration-warning="book_status == 'suspicious'" 
                                decoration-primary="book_status == 'delay'"
                                decoration-success="book_status == 'lent'"
                                decoration-muted="book_status == 'free'"
                                />
                            <field name="return_date" />                            
                        </group>

                        
                        <footer>
                            <button string="Return" class="oe_highlight" data-hotkey="c" name="return_book" type="object"/>
                            <button string="Cancel" special="cancel" class="btn btn-secondary" data-hotkey="x" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>

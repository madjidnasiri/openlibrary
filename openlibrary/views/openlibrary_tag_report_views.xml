<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openlibrary_tag_report_list" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.list</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <list string="Tags Report">
                <field name="tag_id"/>
                <field name="book_repo_count"/>
                <field name="available_count"/>
                <field name="lent_now_count"/>
                <field name="lent_now_percentage" widget="percentage"/>
                <field name="ever_lent_copies"/>
                <field name="total_lend_count"/>
                <field name="ever_lent_percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_openlibrary_tag_report_graph" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.graph</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <graph string="Tags Rent Report" type="pie">
                <field name="tag_id" type="row"/>
                <field name="lent_now_percentage" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_openlibrary_tag_report_graph_genre" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.graph.genre</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <graph string="Number of books by genre" type="pie">
                <field name="tag_id" type="row"/>
                <field name="book_repo_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_openlibrary_tag_report_graph_lent" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.graph.lent</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <graph string="Loaned books by genre" type="pie">
                <field name="tag_id" type="row"/>
                <field name="total_lend_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_openlibrary_tag_report_graph_bar" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.graph.bar</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <graph string="Available books by genre" type="bar">
                <field name="tag_id" type="row"/>
                <field name="available_count" type="measure"/>
            </graph>
        </field>
    </record>    

    <record id="view_openlibrary_tag_report_pivot" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.pivot</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <pivot string="Tags Report" >
                <field name="tag_id" type="row"/>
                <field name="book_repo_count" type="measure"/>
                <field name="available_count" type="measure"/>
                <field name="lent_now_count" type="measure"/>
                <field name="lent_now_percentage" type="measure"/>
                <field name="ever_lent_copies" type="measure"/>
                <field name="total_lend_count" type="measure"/>
                <field name="ever_lent_percentage" type="measure"/>
            </pivot>
        </field>
    </record>


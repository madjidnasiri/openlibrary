    <record id="view_openlibrary_tag_dashboard" model="ir.ui.view">
        <field name="name">openlibrary.tag.report.form</field>
        <field name="model">openlibrary.tag.report</field>
        <field name="arch" type="xml">
            <form string="Tag Report">
                <sheet>
                    <div class="row">
                        <div class="col-6">
                            <widget name="graph" 
                                    string="Books by Genre" 
                                    graph_type="pie"
                                    domain="[]"
                                    fields='{
                                        "tag_id": {"type": "row"}, 
                                        "book_repo_count": {"type": "measure"}
                                    }'/>
                        </div>
                        <div class="col-6">
                            <widget name="graph" 
                                    string="Books Lent by Genre" 
                                    graph_type="pie"
                                    domain="[]"
                                    fields='{
                                        "tag_id": {"type": "row"}, 
                                        "total_lend_count": {"type": "measure"}
                                    }'/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <widget name="graph" 
                                    string="Available Books by Genre" 
                                    graph_type="bar"
                                    domain="[]"
                                    fields='{
                                        "tag_id": {"type": "row"}, 
                                        "available_count": {"type": "measure"},
                                        "total_lend_count": {"type": "measure"}
                                    }'/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions openlibrary.tags_reports -->
    <record id="action_openlibrary_tags_reports" model="ir.actions.act_window">
        <field name="name">Tags Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openlibrary.tag.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="views" eval="[
            (ref('view_openlibrary_tag_report_graph'), 'graph'),
            (ref('view_openlibrary_tag_report_pivot'), 'pivot'),
            (ref('view_openlibrary_tag_report_list'), 'list')
        ]"/>                               
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="path">tags-report</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Openlibrary Tag.
            </p>
        </field>
    </record>

    <record id="action_openlibrary_tag_dashboard" model="ir.actions.act_window">
        <field name="name">Tags Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openlibrary.tag.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_openlibrary_tag_dashboard"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Dashboard for tag statistics and reports.
            </p>
        </field>
    </record>
</odoo>
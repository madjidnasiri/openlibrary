<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
       
        <record id="book_repository_repeat_form" model="ir.ui.view">
            <field name="name">openlibrary.book_repository.wizard.form</field>
            <field name="model">openlibrary.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="number">Let me make a few more of these:</field>
                            <field name="book_edition_id" readonly="False"/>
                            <field name="repository_id" readonly="False"/>
                            <field name="purchase_price" readonly="False"/>
                        </group>
                        <footer>
                           <button string="Create" class="oe_highlight" data-hotkey="c" name="create_book_repo" type="object"/>
                           <button string="Cancel" special="cancel" class="btn btn-secondary" data-hotkey="x" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>

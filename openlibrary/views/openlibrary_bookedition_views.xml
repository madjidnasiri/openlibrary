<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View openlibrary.bookedition View List -->
    <record id="view_openlibrary_bookedition_list" model="ir.ui.view">
        <field name="name">view.openlibrary.bookedition.list</field>
        <field name="model">openlibrary.bookedition</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" readonly="True"/>
                <field name="edition" />
                <field name="publisher_id" />
                <field name="publish_date"  />
                <field name="currency_id" column_invisible="True" />
                <field name="price" widget="manetary" options="{'currency_field': 'currency_id'}"/>
            </list>
        </field>
    </record>

    <!-- View openlibrary.bookedition form -->
    <record id="view_openlibrary_bookedition_form" model="ir.ui.view">
        <field name="name">view.openlibrary.bookedition.form</field>
        <field name="model">openlibrary.bookedition</field>
        <field name="arch" type="xml">
            <form string="Book Editions">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <field name="book_id" string="Book" />
                        <field name="edition" string="Edition" />
                        <field name="publisher_id" string="Publisher"/>
                        <field name="publisher_name" string="Publisher Name" invisible="True"/>
                        <field name="publish_date" eval="time.strftime('%Y-%m-%d')" />
                        <field name="currency_id" invisible="True"/>
                        <field name="price" widget="manetary" options="{'currency_field': 'currency_id'}" eval="0.0"/>
                        <field name="description" string="Description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View openlibrary.bookedition search -->
    <record id="view_openlibrary_bookedition_search" model="ir.ui.view">
        <field name="name">view.openlibrary.bookedition.search</field>
        <field name="model">openlibrary.bookedition</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record>

    <!-- Action openlibrary.bookedition -->
    <record id="action_openlibrary_bookedition" model="ir.actions.act_window">
        <field name="name">Book Editions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openlibrary.bookedition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="path">book-editions</field>

        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Openlibrary bookedition.
            </p>
        </field>
    </record>
</odoo>

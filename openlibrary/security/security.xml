<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data noupdate="0">
      <record id="category_library" model="ir.module.category">
         <field name="name">Library category</field>
         <field name="sequence">15</field>
      </record>

      <record id="res_groups_privilege_openlibrary" model="res.groups.privilege">
         <field name="name">Open Library</field>
         <field name="category_id" ref="category_library"></field>
      </record>

      <record id="group_library_user" model="res.groups">
         <field name="name">Library User</field>
         <field name="privilege_id" ref="res_groups_privilege_openlibrary"/> 
         <field name="sequence">5</field>
         <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
         <!-- 
         <field name="users" eval="[Command.link(ref())]"/> 
         -->
      </record>
      <record id="group_library_employee" model="res.groups">
         <field name="name">Library Employee</field>
         <field name="privilege_id" ref="res_groups_privilege_openlibrary"/> 
         <field name="sequence">4</field>
         <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('openlibrary.group_library_user'))]"/>
         <!-- 
         <field name="users" eval="[Command.link(ref())]"/> 
         -->
      </record>
      <record id="group_library_content_manager" model="res.groups">
         <field name="name">Library Content Manager</field>
         <field name="privilege_id" ref="res_groups_privilege_openlibrary"/> 
         <field name="sequence">3</field>
         <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('openlibrary.group_library_employee'))]"/>
         <!-- 
         <field name="users" eval="[Command.link(ref())]"/> 
         -->
      </record>
      <record id="group_library_manager" model="res.groups">
         <field name="name">Library Manager</field>
         <field name="privilege_id" ref="res_groups_privilege_openlibrary"/> 
         <field name="sequence">2</field>
         <field name="implied_ids" eval="[Command.link(ref('base.group_system')), Command.link(ref('openlibrary.group_library_content_manager')), Command.link(ref('openlibrary.group_library_employee'))]"/>
         <!--
         <field name="users" eval="[Command.link(ref())]"/> 
         -->
      </record>
      <record id="group_libraries_director" model="res.groups">
         <field name="name">Libraries Director</field>
         <field name="privilege_id" ref="res_groups_privilege_openlibrary"/> 
         <field name="sequence">1</field>
         <field name="implied_ids" eval="[Command.link(ref('base.group_system')), Command.link(ref('openlibrary.group_library_manager'))]"/>
         <!-- <field name="users" eval="[Command.link(ref())]"/> -->
      </record>

      <record id="olib_emp_admin" model="ir.rule">
         <field name="name">OLib / Admin Employer </field>
         <field name="model_id" ref="model_openlibrary_lend"/>
         <field name="domain_force">[(1,'=',1)]</field>
         <field name="groups" eval="[(4, ref('group_library_employee'))]"/>
         <field name="perm_read">1</field>
         <field name="perm_create">1</field>
         <field name="perm_write">1</field>
         <field name="perm_unlink">1</field>
      </record>

      <record id="olib_emp_create_by_self" model="ir.rule">
         <field name="name">OLib / Employer - Create By Self</field>
         <field name="model_id" ref="model_openlibrary_lend"/>
         <field name="domain_force">[('create_uid','=',user.id)]</field>
         <field name="groups" eval="[(4, ref('group_library_employee'))]"/>
         <field name="perm_read">1</field>
         <field name="perm_create">1</field>
         <field name="perm_write">1</field>
         <field name="perm_unlink">0</field>
      </record>

      <record id="olib_emp_create_by_other" model="ir.rule">
         <field name="name">OLib / Employer - Create By Other</field>
         <field name="model_id" ref="model_openlibrary_lend"/>
         <field name="domain_force">[('create_uid','!=',user.id)]</field>
         <field name="groups" eval="[(4, ref('group_library_employee'))]"/>
         <field name="perm_read">1</field>
         <field name="perm_create">0</field>
         <field name="perm_write">0</field>
         <field name="perm_unlink">0</field>
      </record>

      <record id="openlibrary_multi_company_rule" model="ir.rule">
         <field name="name">OpenLibrary: Multi-Company Rule</field>
         <field name="model_id" ref="model_openlibrary_library"/>
         <field name="global" eval="True"/>
         <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      </record>

      <record id="openlibrary_book_multi_company_rule" model="ir.rule">
         <field name="name">OpenLibrary Book: Multi-Company Rule</field>
         <field name="model_id" ref="model_openlibrary_book_repository"/>
         <field name="global" eval="True"/>
         <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      </record>

   </data>
</odoo>

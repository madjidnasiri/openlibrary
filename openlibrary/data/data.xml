<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Add you code here -->
        <!-- Job Corn -->
        <record id="ir_cron_update_delay_days" model="ir.cron">
            <field name="name">OpenLibrary: Update Delay Days</field>
            <field name="model_id" ref="model_openlibrary_lend"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_delay_days()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-02-16 01:30:00</field>
            <field name="active">True</field>
        </record>
    </data>
    <data noupdate="1">
        <!-- Sequence -->
        <record id="seq_book_repository_model" model="ir.sequence">
            <field name="name">Book Code in Repositories</field>
            <field name="code">openlibrary.book_repository.code</field>
            <field name="prefix">BC-</field>
            <field name="padding">6</field>
            <field name="number_next">111111</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="openlibrary_delay_warning_threshold" model="ir.config_parameter">
            <field name="key">openlibrary.delay_warning_threshold</field>
            <field name="value">3</field>   <!-- Warning delay: 3 days -->
        </record>
        <record id="openlibrary_delay_suspicious_threshold" model="ir.config_parameter">
            <field name="key">openlibrary.delay_suspicious_threshold</field>
            <field name="value">30</field>  <!-- Suspicious delay: 30 days -->
        </record>        
        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[
                (4, ref('openlibrary.group_library_employee')),
                (4, ref('openlibrary.group_libraries_director'))
            ]"/>
        </record>
   </data>
</odoo>